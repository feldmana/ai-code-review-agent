+package com.agentic.codereview.agent;
+
+import com.agentic.codereview.llm.OllamaClient;
+import com.agentic.codereview.model.ReviewResult;
+import com.google.gson.Gson;
+import com.google.gson.JsonSyntaxException;
+
+import java.io.IOException;
+
+public class ReviewResponseParser {
+
+    private final Gson gson = new Gson();
+    private final OllamaClient ollamaClient;
+
+    public ReviewResponseParser(OllamaClient ollamaClient) {
+        this.ollamaClient = ollamaClient;
+    }
+
+    /**
+     * Primary entry point
+     */
+    public ReviewResult parse(String rawResponse, String originalPrompt) throws IOException {
+
+        // 1. First attempt: direct parse (NO CLEANING)
+        try {
+            return gson.fromJson(rawResponse, ReviewResult.class);
+        } catch (JsonSyntaxException e) {
+            System.err.println("❌ JSON parse failed. Attempting repair...");
+
+            // 2. Fallback: ask LLM to fix JSON
+            String repaired = repairJson(rawResponse, originalPrompt);
+
+            // 3. Second attempt: parse repaired output
+            try {
+                return gson.fromJson(repaired, ReviewResult.class);
+            } catch (JsonSyntaxException ex) {
+                System.err.println("❌ Repair also failed. Returning empty result.");
+
+                return emptyResult();
+            }
+        }
+    }
+
+    /**
+     * Ask LLM to fix broken JSON
+     */
+    private String repairJson(String brokenJson, String originalPrompt) throws IOException {
+
+        String repairPrompt =
+                "You are a JSON repair engine.\n" +
+                "Fix the following JSON.\n" +
+                "RULES:\n" +
+                "- Return ONLY valid JSON\n" +
+                "- No explanations\n" +
+                "- No extra text\n\n" +
+                "ORIGINAL CONTEXT:\n" + originalPrompt + "\n\n" +
+                "BROKEN JSON:\n" + brokenJson;
+
+        return ollamaClient.generateResponse(repairPrompt);
+    }
+
+    /**
+     * Safe fallback result
+     */
+    private ReviewResult emptyResult() {
+        return new ReviewResult(
+                "empty",
+                java.util.Collections.emptyList(),
+                java.util.Collections.emptyList(),
+                ReviewResult.Severity.LOW
+        );
+    }
+}
